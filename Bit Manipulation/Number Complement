import java.util.ArrayList;
class Solution {
    public int findComplement(int num) {
        ArrayList<Integer> list = new ArrayList<Integer>();
        while(num>0){
            list.add(num%2);
            num = num/2;
        }
        for(int i =0; i<list.size();i++){
            if(list.get(i)==1){
                list.set(i,0);
            }
            else{
                list.set(i,1);
            }
        }
        int ans  = 0;
        for (int i = 0; i < list.size(); i++) {
            ans = ans + list.get(i) * Math.powExact(2,i);
        }
        return ans;
    }
}
