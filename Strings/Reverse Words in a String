class Solution {
    public String reverseWords(String s) {
        StringBuilder sb = new StringBuilder();
        String[] words = s.trim().split("\\s+");
        int n = words.length;
        for(int i =n-1;i>=0;i--){
            sb.append(words[i]);
            sb.append(" ");
        }
        String ans = sb.toString();
        return ans.trim();
        
    }
}
