import java.util.ArrayList;
class Solution {
    public int numberofbits(int n){
        ArrayList<Integer> list = new ArrayList<Integer>();
        int count = 0;
        while(n>0){
            list.add(n%2);
            n =n/2;
        }
        for(int i =0; i<list.size();i++){
            if(list.get(i) == 1){
                count++;
            }
            else{
                continue;
            }
        }
        return count;
    }
    public int[] countBits(int n) {
        int ans [] = new int [n+1];
        for(int i =0; i<n+1;i++){
            int number = numberofbits(i);
            ans[i] = number;
        }
        return ans;
    }
}
