class Solution {
    public int lengthOfLoop(Node head) {
        Node fast = head;
        Node slow = head;
        while(fast != null && fast.next !=null){
            fast = fast.next.next;
            slow = slow.next;
            if(slow == fast){
                int len = 1;
                fast = fast.next;
                while(fast != slow){
                    len++;
                    fast = fast.next;
                }
                
                return len;
            }
        }
        
        return 0;
    }
}
