import java.util.PriorityQueue;
class triplets implements Comparable<triplets>{
    int x ;
    int y ;
    double div;
    triplets(int x, int y , double div){
        this.x = x;
        this.y = y;
        this.div = div;
    }
    public  int compareTo(triplets t){
    return Double.compare(this.div,t.div);
    }   
}
class Solution {
    public static void add(PriorityQueue<triplets> pq,int [] arr){
        int n = arr.length;
        for(int i =0; i<n-1;i++){
            for(int j =i+1;j<n;j++){
                double num1 = (double)arr[i];
                double num2 = (double)arr[j];
                triplets t = new triplets(arr[i],arr[j],num1/num2);
                pq.add(t);
            }
        }
    }
    public int[] kthSmallestPrimeFraction(int[] arr, int k) {
        PriorityQueue<triplets> pq = new PriorityQueue<triplets>();
        add(pq,arr);
        for(int i =0; i<k-1;i++){
            pq.remove();
        }
        triplets top = pq.peek();
        int [] ans = new int[2];
        ans[0] = top.x;
        ans[1] = top.y;
        return ans;
    }
}
