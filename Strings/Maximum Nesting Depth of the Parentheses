class Solution {
    public int maxDepth(String s){
        int n = s.length();
        int count = 0;
        int curr = 0;
        for(int i =0; i<n;i++){
            if(s.charAt(i)=='('){
                curr++;
                if (curr>count){
                    count = curr;
                }
            }
            if(s.charAt(i)==')'){
                curr--;
            }
        }
        return count;
    }
}
