import java.util.ArrayList;
class Solution {
    public int[] evenOddBit(int n) {
        ArrayList<Integer> list = new ArrayList<Integer>();
        while(n>0){
            list.add(n%2);
            n = n/2;
        }
        int evenCount = 0;
        int oddCount = 0;
        for(int i =0; i<list.size();i++){
            if(list.get(i)==1 && i%2==0){
                evenCount++;
            }
            else if (list.get(i)==1 && i%2!=0){
                oddCount++;
            }
            else{
                continue;
            }
        }
        int ans [] = new int [2];
        ans[0] = evenCount;
        ans[1] = oddCount;

        return ans;
    } 
}
