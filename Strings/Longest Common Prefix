class Solution {
    public String longestCommonPrefix(String[] strs) {
        int n = strs.length;
        int min = Integer.MAX_VALUE;
        StringBuilder sb = new StringBuilder();
        for(int i =0; i<n;i++){
            if(strs[i].length()<min){
                min = strs[i].length();
            }
        }
        for(int i =0; i<min;i++){
            char ch = strs[0].charAt(i);
            boolean flag = false;
            for(int j =0; j<n;j++){
                if(strs[j].charAt(i)==ch){
                    flag = true;
                }
                else{
                    flag = false;
                    break;
                }
            }
            if(flag){
                sb.append(ch);
            }
            else{
                break;
            }
        }
        return sb.toString();
    }
}
