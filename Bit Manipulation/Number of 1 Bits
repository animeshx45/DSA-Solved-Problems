import java.util.ArrayList;
import java.util.Collections;
class Solution {
    public int hammingWeight(int n) {
        int count = 0;
        ArrayList<Integer> list = new ArrayList<Integer>();
        while(n>0){
            list.add(n%2);
            n = n/2;
        }
        Collections.reverse(list);
        for(int i =0; i<list.size();i++){
            if(list.get(i)==1){
                count++;
            }
        }
        return count;
    }
}
