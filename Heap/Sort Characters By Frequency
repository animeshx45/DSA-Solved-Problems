import java.util.PriorityQueue;
import java.util.Collections;
class doublet implements Comparable<doublet>{
    char ch ;
    int freq;
    doublet(char ch, int freq){
        this.ch = ch;
        this.freq = freq;
    }
    public int compareTo(doublet d){
        return Integer.compare(this.freq, d.freq);
    }
}
class Solution {
    public static void add(PriorityQueue<doublet> pq , String s){
    HashMap<Character, Integer> map = new HashMap<>();
    for (char c : s.toCharArray()) {
        map.put(c, map.getOrDefault(c, 0) + 1);
    }
    for (Map.Entry<Character, Integer> entry : map.entrySet()) {
        pq.add(new doublet(entry.getKey(), entry.getValue()));
    }
    }
    public String frequencySort(String s) {
        PriorityQueue<doublet> pq = new PriorityQueue<doublet>(Collections.reverseOrder());
        add(pq,s);
        StringBuilder sb = new StringBuilder();
        while(pq.size()>0){
            doublet top = pq.remove();
            for(int i =0; i<top.freq;i++){
                sb.append(top.ch);
            }
        }
        String ans = sb.toString();
        return ans;
    }
}
