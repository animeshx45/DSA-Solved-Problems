class Solution {
    public boolean detectCapitalUse(String word){
        boolean flag1 = true;
        boolean flag2 = true;
        boolean flag3 = true;
        char arr[] = word.toCharArray();
        for (int i = 0; i < arr.length; i++) {
            if (Character.isUpperCase(arr[i])){
                flag1 = true;
            }
            else{
                flag1 = false;
                break;
            }
        }
        for (int i = 0; i < arr.length; i++) {
            if (Character.isLowerCase(arr[i])){
                flag2 = true;
            }
            else{
                flag2 = false;
                break;
            }
        }
        if(Character.isUpperCase(arr[0])){
            for (int i = 1; i < arr.length; i++) {
                if (Character.isLowerCase(arr[i])){
                    flag3 = true;
                }
                else{
                    flag3 = false;
                    break;
                }
            }
        }
        else{
            flag3 = false;
        }
        if (flag1 || flag3 || flag2){
            return true;
        }
        else {
            return false;
        }
    }
}
