class Solution {
    public static boolean isPossible(int [] arr,int i , int m , int k){
        int count = 0; int num = 0;
        for(int t =0; t<arr.length;t++){
            if(arr[t]<=i){
                count++;
            }
            else{
                num += count/k;
                count = 0;
            }
        }
        num += count/k;
        if(num<m){
            return false;
        }
        return true;
    }
    public int minDays(int[] bloomDay, int m, int k) {
        int n = bloomDay.length;
        if((m*k)>n){
            return -1;
        }
        int min = Integer.MAX_VALUE;
        int max = Integer.MIN_VALUE;
        int ans = -1;
        for(int i =0; i<n;i++){
            if(bloomDay[i]>max){
                max = bloomDay[i];
            }
        }
        for(int i =0; i<n;i++){
            if(bloomDay[i]<min){
                min = bloomDay[i];
            }
        }
        int i = min; int j = max;
        while(i<=j){
            int mid = (i+j)/2;
            if(isPossible(bloomDay,mid,m,k)){
                ans = mid;
                j = mid-1;
            }
            else{
                i = mid+1;
            }
        }
        return ans;
    }
}
