import java.util.ArrayList;
class Solution {
    public int bitwiseComplement(int n) {
        if(n == 0){
            return 1;
        }
        ArrayList<Integer> list = new ArrayList<Integer>();
        while(n>0){
            list.add(n%2);
            n = n/2;
        }
        for(int i =0; i<list.size();i++){
            if(list.get(i) == 1){
                list.set(i,0);
            }
            else{
                list.set(i,1);
            }
        }
        int number = 0;
       for(int i =0; i<list.size();i++){
        number = number + list.get(i)*(Math.powExact(2,i));
       }
        return number;
    }
}
