class Solution {
    public boolean isMonotonic(int[] nums) {
        boolean flag = true;
        boolean flag1 = true;
        for(int i =0; i<nums.length-1;i++){
            if(nums[i]>=nums[i+1]){
                flag = true;
            }
            else {
                flag = false;
                break;
            }
        }
        for(int i =0; i<nums.length-1;i++){
            if(nums[i]<=nums[i+1]){
                flag1 = true;
            }
            else {
                flag1 = false;
                break;
            }
        }
        if(flag== true || flag1 == true){
            return true;
        }
        else{
            return false;
        }
        
    }
}
