class Solution {
    public int[] findPeakGrid(int[][] mat) {
        int n = mat.length;
        int max = Integer.MIN_VALUE;
        int row = -1;
        int col = -1;
        for(int i =0;i<n;i++){
            for(int j =0; j<mat[i].length;j++){
                if(mat[i][j]>max){
                    max = mat[i][j];
                    row = i;
                    col = j;
                }
            }
        }
        int [] arr = new int[2];
        arr[0] =row;
        arr[1]=col;
        return arr;
    }
}
