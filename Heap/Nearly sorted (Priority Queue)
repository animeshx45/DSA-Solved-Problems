import java.util.PriorityQueue;
class Solution {
    public void add(int [] arr, PriorityQueue<Integer> pq){
        int n = arr.length;
        for(int i = 0; i<n; i++){
            pq.add(arr[i]);
        }
    }
    public void nearlySorted(int[] arr, int k) {
        PriorityQueue<Integer> pq = new PriorityQueue<Integer>();
        add(arr,pq);
        int n = arr.length;
        for(int i = 0;i<n;i++){
            arr[i] = pq.remove();
        }
        
    }
}
