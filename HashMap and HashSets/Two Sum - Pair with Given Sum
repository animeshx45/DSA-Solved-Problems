import java.util.HashSet;
class Solution {
    boolean twoSum(int arr[], int target) {
        HashSet<Integer> set = new HashSet<Integer>();
        int n = arr.length;
        for(int i =0; i<n;i++){
            int num = target - arr[i];
            if(set.contains(num)){
                return true;
            }
            else{
                set.add(arr[i]);
            }
        }
        return false;
    }
}
