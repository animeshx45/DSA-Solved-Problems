import java.util.HashMap;
class Solution {
    public int findLucky(int[] arr) {
        HashMap<Integer,Integer> map = new HashMap<>();
        int lucky = -1;
        for(int ele : arr){
            map.put(ele,map.getOrDefault(ele,0)+1);
        }
        for(int ele : map.keySet()){
            int freq = map.get(ele);
            if(freq == ele){
                if(lucky<ele){
                    lucky = ele;
                }
                else{
                    continue;
                }
            }
            else{
                continue;
            }
        }
        return lucky;
    }
