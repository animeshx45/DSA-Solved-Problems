class Solution {
    public String largestOddNumber(String num) {
        int n = num.length();
        StringBuilder sb = new StringBuilder();
        int idx =-1;
        for(int i =n-1;i>=0;i--){
            if(num.charAt(i)%2!=0){
                idx = i;
                break;
            }
        }
        for(int i =0; i<=idx;i++){
            sb.append(num.charAt(i));
        }
        return sb.toString();
        
    }
}
