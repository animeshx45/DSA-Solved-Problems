import java.util.PriorityQueue;
class Solution {
    public static void add(int[] arr, PriorityQueue<Integer> pq){
        int n = arr.length;
        for(int i = 0; i<n;i++){
            pq.add(arr[i]);
        }
    }
    public static int minCost(int[] arr) {
        int n = arr.length;
        if(n==1){
            return 0;
        }
        PriorityQueue<Integer> pq = new PriorityQueue<Integer>();
        add(arr,pq);
        int cost = 0;
while (pq.size() > 1) {
    int first = pq.poll();
    int second = pq.poll();
    int sum = first + second;
    cost += sum;       // add to total cost
    pq.add(sum);       // push back into heap
}
return cost;
}
}
