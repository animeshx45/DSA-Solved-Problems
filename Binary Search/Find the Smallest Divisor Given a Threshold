import java.util.Arrays;
class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        Arrays.sort(nums);
        int i =1; int j = nums[nums.length-1];
        int ans = -1;
        while(i<=j){
            int sum = 0;
            int mid = i+(j-i)/2;
            for(int ele: nums){
                sum += (ele + mid - 1) / mid;

            }
            if (sum<=threshold){
                ans = mid;
                j = mid-1;
            }
            else{
                i = mid+1;
            }
        }
        return ans;
    }
}
