class Solution {
    public boolean isPowerOfTwo(int n) {
        int idx = (int)Math.ceil(Math.sqrt(n));
        for (int i = 0; i <=idx; i++) {
            if (Math.pow(2, i) == n) {
                return true;
            }
            else{
                continue;
            }
        }
        return false;
    }
}
