import java.util.Stack;
class Solution {
    public String makeGood(String s) {
        char arr[] = s.toCharArray();
        Stack<Character> st = new Stack<>();
        Stack<Character> st1 = new Stack<>();
        for(char ch : arr){
            st.push(ch);
        }
        while(!st.isEmpty()){
            if (st1.isEmpty()){
                st1.push(st.pop());
            }
            else if(Math.abs(st1.peek()-st.peek())==32){
                st1.pop();
                st.pop();
            }
            else{
                st1.push(st.pop());
            }
        }
        StringBuilder sb = new StringBuilder();
        while(!st1.isEmpty()){
            sb.append(st1.pop());
        }
        String ans = sb.toString();
        return ans;
    }
}
