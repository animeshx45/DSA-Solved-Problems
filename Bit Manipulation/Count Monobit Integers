import java.util.ArrayList;
class Solution {
    public boolean isSatisfy(int num){
        if(num == 0){
            return true;
        }
        ArrayList<Integer> list = new ArrayList<Integer>();
        while(num>0){
            list.add(num%2);
            num = num/2;
        }
        if(list.size()==1){
            return true;
        }
        int number = list.get(0);
        for(int i =1; i<list.size();i++){
            if(list.get(i) != number){
                return false;
            }
        }
        return true;
    }
    public int countMonobit(int n) {
        int count = 0;
        for(int i =0; i<=n;i++){
            if(isSatisfy(i)){
                count++;
            }
        }
        return count++;
    }
}
