import java.util.PriorityQueue;
class doublet implements Comparable<doublet>{
    int data;
    int freq;
    doublet(int data, int freq){
        this.data = data;
        this.freq = freq;
    }
    public int compareTo(doublet d){
        return Integer.compare(this.freq,d.freq);
    }
}
class Solution {
   public static void add(PriorityQueue<doublet> pq, int[] arr) {
        HashMap<Integer, Integer> freqMap = new HashMap<>();
        for (int num : arr) {
            freqMap.put(num, freqMap.getOrDefault(num, 0) + 1);
        }
        for (int key : freqMap.keySet()) {
            pq.add(new doublet(key, freqMap.get(key)));
        }
    }
    public int[] topKFrequent(int[] nums, int k) {
        PriorityQueue<doublet> pq = new PriorityQueue<doublet>(Collections.reverseOrder());
        add(pq,nums);
        int [] ans = new int[k];
        for(int i =0; i<k;i++){
            doublet d1 = pq.remove();
            ans[i] = d1.data;
        }
        return ans;
    }
}
